# ── Cadence configuration ────────────────────────────────────────────────────────────────────
# Copy to .env. With NO keys set, the app runs end-to-end on deterministic offline defaults + the
# seeded universe. Add the two keys below to light up the live paths — nothing else changes.

# Local Postgres + pgvector (started by `make docker-up`).
DATABASE_URL=postgresql://cadence:cadence_dev@localhost:5436/cadence

# ── 1) OpenRouter — natural-language query parsing (LLM) ──────────────────────────────────────
# Key: https://openrouter.ai/keys . With this set, typed queries are parsed by an LLM into editable
# structured filters; without it, a transparent heuristic parser is used. OpenAI-compatible.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# ── 2) LakeB2B Data API — live identity + verified-contact source ─────────────────────────────
# Set the key + base URL, switch DATA_SOURCE to lakeb2b, then run `make ingest` to pull live
# firms + partners + verified contacts. (LakeB2B supplies the identity/contact/firmographic layer;
# behavioral deal/fund data stays on the seeded source until a deal source is wired.)
LAKEB2B_API_KEY=
LAKEB2B_BASE_URL=
DATA_SOURCE=seed                 # seed | lakeb2b

# ── Optional: hosted embeddings ───────────────────────────────────────────────────────────────
# Embeddings default to a deterministic, offline model (no key, fully hermetic). OpenRouter does
# NOT serve embeddings — set an OpenAI key here only for sharper hosted sector ranking.
OPENAI_API_KEY=
# OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ── Tuning ────────────────────────────────────────────────────────────────────────────────────
ACTIVITY_WINDOW_MONTHS=24
CONTACT_SLA_DAYS=180             # 90 = premium tier, 180 = standard tier
LOG_LEVEL=info
